// 本设备（cannon, MT6853T）A12 厂商 blob 与 A14 框架库之间的符号兼容垫片
//
// 背景：厂商堆栈是 A12，系统框架是 A14。老的 A12 二进制进程会从 /system 加载
// A14 的 libhidlbase/libbinder/libutils/libui，而 A14 删掉/改动了部分符号
// （gBnsConstructorMap、GraphicBufferMapper::lock、String16 移动语义、
//  strncpy16 等），导致 "cannot locate symbol ..." 而崩溃。
//
// 正解（LineageOS 官方做法）：不修改任何 blob 文件，而是用 LINKER 的
// LD_SHIM_LIBS 机制，在加载目标时把垫片“预加载”进同一进程/命名空间，
// 由垫片补齐缺失符号。映射表写在 BoardConfig.mk 的 TARGET_LD_SHIM_LIBS。
//
// 关键设计：映射的 key 直接写具体的 /vendor/bin/<HAL 进程>，
// 因此垫片只进入这些本来就已经坏掉的 HAL 进程，
// 不会影响 surfaceflinger/zygote/system_server 等引导关键进程。
//
// 源码直接复用 hardware/lineage/compat/ 下的 LineageOS 官方实现。

cc_library_shared {
    name: "libshim_cannon_vendor",
    // 源码拷自 hardware/lineage/compat/（LineageOS 官方实现，Apache-2.0）
    // soong 的 srcs 相对本模块目录解析，故必须放在本地
    srcs: [
        "src/gBnsConstructorMap.cpp",
        "src/Fence.cpp",
        "src/GraphicBuffer.cpp",
        "src/GraphicBufferMapper.cpp",
        "src/IServiceManager.cpp",
        "src/PermissionCache.cpp",
        "src/Thread.cpp",
        "src/String16.cpp",
        "src/String16_shim.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libui",
        "libsync",
        "libutils",
        "libbinder",
        "libdl",
    ],
    vendor: true,
    compile_multilib: "both",
}

// 2026-10-30 第十八轮：补 A15 libc++ 新符号 std::__1::__libcpp_verbose_abort
//
// A15 的 /system/lib64/libunwindstack.so 引用 _ZNSt3__122__libcpp_verbose_abortEPKcz，
// A12 vendor 的 /vendor/lib64/libc++.so 不提供。当 vendor gralloc HAL 在 sphal 命名空间
// 被 dlopen 时该符号解析失败 → gralloc-mapper 缺失 → GraphicBufferMapper LOG_ALWAYS_FATAL
// → media.swcodec 崩溃循环（没声）。垫片只导出这一个符号，patchelf 烤进 gralloc impl。
cc_library_shared {
    name: "libshim_cpp_verbose_abort",
    srcs: [
        "src/CppVerboseAbort.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
    vendor: true,
    compile_multilib: "both",
}

// 传感器符号（convertToSensorEvent）—— 原有垫片，mnld 需要
cc_library_shared {
    name: "libshim_sensors",
    whole_static_libs: [
        "android.hardware.sensors@1.0-convert"
    ],
    shared_libs: [
        "libhardware",
        "libhidlbase",
        "android.hardware.sensors@1.0"
    ],
    vendor: true
}

// 2026-10-27 vtservice（MTK 视频电话服务，装在 system 分区）
//
// /system/lib64/libsource.so 是 A12 的 MTK blob，引用 A12 版
// GraphicBufferMapper::lock(6 参数) 与 unlock(1 参数)；A14 的 libui 已把这两个
// 签名都改掉（lock 去掉 outBytesPerPixel/outBytesPerStride，unlock 增加 fence），
// 于是 vtservice 报 "cannot locate symbol ... GraphicBufferMapper4lockE..."，init 每 5s 重启一次。
//
// 不能复用 libshim_cannon_vendor：那个模块是 vendor: true，产物落在 /vendor/lib64，
// 而 libsource.so 在 system 命名空间里搜不到 vendor 路径；而且它把 String16/Thread/
// PermissionCache 等垫片符号一起带进来，会覆盖 vtservice 进程里 A14 libutils 的
// 正常实现。所以这里只编 GraphicBufferMapper 一份源码，装到 /system/lib64。
cc_library_shared {
    name: "libshim_cannon_system",
    srcs: [
        "src/GraphicBufferMapper.cpp",
        "src/AudioTrack.cpp",
    ],
    shared_libs: [
        "libaudioclient",
        "libui",
        "libsync",
        "libutils",
    ],
    // AudioTrack.h 会 include <media/Modulo.h>，那个头在 libmedia 里，
    // 而 libaudioclient 没有把它导出，所以显式挂上（只取头，不产生运行时依赖）。
    header_libs: [
        "libmedia_headers",
    ],
    compile_multilib: "64",
}

// 2026-11-01 A16：把 libnetutils 的 vendor 变体拉进 /vendor/lib64
//
// /vendor/bin/hw/tetheroffloadservice（A12 vendor blob）ELF NEEDED libnetutils.so，
// 但 A16 重建 vendor 时没把它放进 /vendor/lib64（proprietary-files.txt 亦未登记）→
// linker "library libnetutils.so not found" → HAL 起不来 → Tethering 无限等待
// android.hardware.tetheroffload.config@1.0::IOffloadConfig/default（每次 1s 重试）→
// startTethering 卡死 → 设置里开热点 ANR。
//
// 本模块本身是空壳，仅靠 shared_libs 依赖把 vendor_available:true 的 libnetutils
// 以 vendor 变体编出来并装到 /vendor/lib64（顺带 /vendor/lib）。不改任何 blob。
cc_library_shared {
    name: "libnetutils_vendor_dep",
    vendor: true,
    srcs: ["src/netutils_dep_stub.c"],
    shared_libs: ["libnetutils"],
    compile_multilib: "both",
}

// 2026-11-17 A17 codec2 HAL 每 5 秒 CANNOT LINK
//
// /vendor/bin/hw/android.hardware.media.c2@1.2-mediatek（A12 blob）经
// libcodec2_vndk.so 引用 GraphicBufferMapper::lock 的 6 参数版本
// （_ZN7android19GraphicBufferMapper4lockEPK13native_handlejRKNS_4RectEPPvPiS9_），
// A17 的 libui 已删除该符号 -> linker 直接拒绝执行，init 每 5 秒重启一次。
//
// A17 linker 不再实现 TARGET_LD_SHIM_LIBS，改由 c2 HAL 的 init rc 里
// setenv LD_PRELOAD 预加载；这里只装 GraphicBufferMapper 一份源码，
// 不能复用 libshim_cannon_vendor（会覆盖进程里 A17 libutils 的正常实现）。
cc_library_shared {
    name: "libshim_gbm_only",
    srcs: [
        "src/GraphicBufferMapper.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libui",
        "libsync",
        "libutils",
    ],
    vendor: true,
    compile_multilib: "both",
}

// 2026-11-18 A17 AIDL codec2（64 位）
//
// MTK Q 的 libcodec2_hidl@1.0.so NEEDED libstagefright_bufferqueue_helper.so，
// 但 A17 的 bqhelper 在 vendor 命名空间里需要 libgui/libEGL/libnativewindow 等
// 只存在于 /system 的库，装不进 /vendor；装 /system 变体又会拖进 libmedia 一大串。
// 这里用同名 stem 只导出 blob 引用的 GraphicBufferSource 符号的空实现，
// 解码路径不会调用（只有 c2 硬件编码的输入 surface 才会）。
//
// 安装名不叫 libstagefright_bufferqueue_helper.so，而是靠 SONAME 匹配：
// rc 里 LD_PRELOAD 它，blob 的 DT_NEEDED 会通过 SONAME 命中已加载的这份，
// 避免与 AOSP 的 bqhelper 在 /vendor 里抢同一个文件（Soong 会生成坏边）。
cc_library_shared {
    name: "libc2_bq_stub",
    srcs: ["src/GraphicBufferSource_stub.cpp"],
    vendor: true,
    compile_multilib: "64",
    cflags: ["-Wno-reserved-identifier"],
    ldflags: ["-Wl,-soname,libstagefright_bufferqueue_helper.so"],
}

// 2026-11-19 硬解 AIDL：补 A17 libcodec2_vndk 需要的
// BufferAllocator::Alloc(string, size_t, unsigned)（3 参数重载）。
// 厂商 libdmabufheap.so 只有 4 参数版本；只把这个 shim 预加载进
// codec2 AIDL 服务，避免替换全局 libdmabufheap 破坏 gralloc/SF。
cc_library_shared {
    name: "libshim_dmabuf_alloc",
    srcs: [
        "src/DmabufAllocShim.c",
    ],
    shared_libs: [
        "libdl",
    ],
    vendor: true,
    compile_multilib: "64",
}

// 以 mediacodec 域 + LD_PRELOAD 启动 codec2 AIDL 服务（Magisk 模块用）
cc_binary {
    name: "c2aidl_launch",
    srcs: [
        "src/C2AidlLaunch.c",
    ],
    shared_libs: [
        "libselinux",
    ],
    vendor: true,
    compile_multilib: "64",
}

// 吞掉 AIBinder_markVintfStability，让模块自带的 AIDL store 无需 VINTF 声明即可注册
cc_library_shared {
    name: "libshim_no_vintf",
    srcs: [
        "src/NoVintfShim.c",
    ],
    vendor: true,
    compile_multilib: "64",
}
