// libcamera_metadata 是 native:vndk 链接类型，Soong 不会把 vendor 变体装进 /vendor，
// 但 MTK camera blob 有 DT_NEEDED libcamera_metadata.so（libcamera_metadata_shim
// 也是靠 dlsym(RTLD_NEXT) 转发给它）。这里用模块引用做成 prebuilt 装进 /vendor，
// 文件名用 stem 保持 libcamera_metadata.so。
cc_prebuilt_library_shared {
    name: "libcamera_metadata_cannon",
    stem: "libcamera_metadata",
    vendor: true,
    srcs: [":libcamera_metadata"],
    strip: {
        none: true,
    },
}
