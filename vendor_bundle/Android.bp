// [cannon][A17][2026-11-20] 依赖锚点（桩模块）
//
// 背景：Soong 只会在两种情况下把 vendor_available 库的 vendor 变体装进
// out/.../vendor/lib{,64}/：
//   1) 模块本身 vendor: true；
//   2) 有别的 vendor 模块依赖它（shared_libs / static_libs）。
// 下面这批库在 vendor 侧只是被 dlopen（SurfaceFlinger、media HAL、MTK blob），
// 没有任何链接依赖，所以即使写进 PRODUCT_PACKAGES 也只装 /system 那份 ——
// .intermediates 里 vendor 变体编得出来，staging 里就是没有，最后只能在
// tools/a16_preassemble_vendor.sh 里手工从 system 拷（A16 遗留 hack）。
//
// 这两个模块本身不导出任何有意义的符号，唯一作用是造 vendor 依赖边，
// 让 Soong 在分析成图的时候就把这些库的 vendor 变体一起装进 vendor 镜像、
// 登记进 file_list、并建立到 vendor.img 的依赖边。
//
// 拆成两个模块是必须的：libcodec2_soft_common 会间接依赖
// android.hardware.graphics.common-V7-ndk，而 vendor 里还有个 32 位 blob 要 V5。
// Soong 不允许同一个模块同时依赖同一 aidl_interface 的两个版本
// （"depends on multiple versions of the same aidl_interface"），所以 AIDL 接口库
// 单独放一个模块，两条依赖链互不相交。

cc_library_shared {
    name: "libcannon_vendor_bundle",
    vendor: true,
    srcs: ["empty.cpp"],
    shared_libs: [
        // 通用库
        "libion",
        "libexpat",
        "libcppbor_external",
        "libprotobuf-cpp-lite-21.12-vendorcompat",
        "libcodec2_soft_common",
        "libcurl",
        "libunwindstack",
        "libutilscallstack",
        "liblzma",
        "libexif",
        // MTK vendor 接口库（HIDL cc_library，不是 AIDL）
        "vendor.mediatek.hardware.bluetooth.audio@2.1",
        "vendor.mediatek.hardware.bluetooth.audio@2.2",
        "vendor.mediatek.hardware.lbs@1.0",
        "vendor.mediatek.hardware.mtkradioex@3.0",
        "vendor.mediatek.hardware.netdagent@1.0",
    ],
    // 桩模块没有实际功能，别让 strip 把它弄成空文件导致安装步骤异常
    strip: {
        none: true,
    },
}

cc_library_shared {
    name: "libcannon_vendor_bundle_aidl",
    vendor: true,
    srcs: ["empty_aidl.cpp"],
    shared_libs: [
        "android.hardware.audio.common-V3-ndk",
        "android.hardware.bluetooth.audio-V4-ndk",
        "android.hardware.graphics.common-V5-ndk",
        "android.media.audio.common.types-V3-ndk",
        "android.hardware.sensors-V2-ndk",
    ],
    strip: {
        none: true,
    },
}
